# Nerya environment template.
# Real secrets live inside the SecretVault (workspace/vault/secrets.enc),
# not in env vars. These are only adapter hints used at bootstrap.

NERYA_WORKSPACE=~/.nerya
NERYA_LIVE_TRADING=false
NERYA_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# GWDC acceptance evidence (fill these in only for a real acceptance run).
# Kiln and Blockchain are independent lanes: Kiln calls the NPU LLM over HTTP;
# Blockchain anchors a decision on an EVM testnet. Never commit real secrets.
# ---------------------------------------------------------------------------

# Kiln NPU LLM lane (Anthropic Messages API compatibility)
# Claude Code and compatible clients read these names directly. Kiln's current
# gateway is the Bricksum endpoint; do not append /v1 unless Kiln gives you a
# different compatible URL.
ANTHROPIC_BASE_URL=https://api.bricksum.com
# Kiln API credential. Keep empty in this template and never commit the value.
ANTHROPIC_AUTH_TOKEN=
# Required model for the GWDC check.
ANTHROPIC_MODEL=deepseek-v4.1-flash
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4.1-flash
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4.1-flash
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4.1-flash
# Kiln advertises a 131072-token context for this model.
CLAUDE_CODE_MAX_CONTEXT_TOKENS=131072
# Nerya-side aliases used by the acceptance evidence runner.
KILN_API_URL=https://api.bricksum.com
KILN_API_KEY=
KILN_MODEL=deepseek-v4.1-flash
# Logical flow label used in token-usage evidence and logs.
KILN_FLOW_ID=gwdc-acceptance
# Optional request timeout and evidence output location.
KILN_TIMEOUT_SECONDS=120
KILN_EVIDENCE_PATH=.tmp/kiln-evidence.jsonl

# EVM testnet blockchain lane
# Choose sepolia or base-sepolia and provide its JSON-RPC endpoint.
NERYA_TESTNET_CHAIN=sepolia
NERYA_TESTNET_RPC_URL=https://<sepolia-rpc-endpoint>
# SecretVault reference for the testnet signer; do not paste a private key here.
# Example: vault://testnet-sepolia-signer
NERYA_TESTNET_SIGNER_REF=vault://sepolia-signer
# Optional public explorer base URL for the final evidence report.
NERYA_TESTNET_EXPLORER_URL=https://sepolia.etherscan.io/tx/
# Contract source to deploy/anchor. Existing mandate contract is the default.
NERYA_TESTNET_CONTRACT=contracts/mandates
# Evidence file containing contract address, tx hash, receipt and block number.
NERYA_TESTNET_EVIDENCE_PATH=.tmp/testnet-evidence.json

# Optional: override the master passphrase used to seal the SecretVault.
# If unset Nerya derives one from the local keyring.
# NERYA_VAULT_PASSPHRASE=change-me

# Nerya runs as a self-contained Nerya-native runtime. It does not
# attach to any external agent runtime; external agents integrate
# through the MCP and ACP bridges only.
