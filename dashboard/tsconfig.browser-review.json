{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "messages/**/*.ts",
    "i18n/**/*.ts",
    ".next-browser-review/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tests/e2e"
  ]
}
